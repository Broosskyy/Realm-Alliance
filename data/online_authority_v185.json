{
  "version": "1.85",
  "master_concept": "V2.2",
  "mode": "local_development",
  "production_target": "online_authoritative",
  "request_contract_version": "authority-intent-v1",
  "result_contract_version": "authority-result-v1",
  "offline_queue_policy": {
    "safe": [
      "settings",
      "analytics_batch"
    ],
    "review": [
      "tap_progress",
      "noncompetitive_pve_intent"
    ],
    "forbidden": [
      "purchase",
      "spend_currency",
      "claim_reward",
      "open_chest",
      "spin_result",
      "pvp_result"
    ]
  },
  "server_time_required": [
    "daily",
    "goldmine",
    "temple",
    "events",
    "seasons",
    "offers",
    "cooldowns"
  ],
  "economy_contract_version": "economy-transaction-v1",
  "snapshot_contract_version": "player-snapshot-v3",
  "max_pending_intents": 64,
  "sync_request_contract_version": "player-sync-request-v1",
  "reconciliation_contract_version": "sync-reconciliation-v1",
  "remote_snapshot_policy": {
    "reject_stale_revision": true,
    "require_server_time": true,
    "apply_state_only_after_validation": true,
    "never_fake_remote_response": true
  },
  "auth_contract_version": "auth-session-v1",
  "transport_contract_version": "realm-http-transport-v1",
  "remote_apply_contract_version": "remote-state-apply-v1",
  "transport": {
    "enabled": false,
    "base_url": "",
    "require_https": true,
    "connect_timeout_seconds": 12,
    "request_timeout_seconds": 20,
    "max_response_bytes": 1048576,
    "max_retries": 2,
    "retry_backoff_seconds": [
      1,
      3
    ],
    "disconnect_after_consecutive_failures": 3
  },
  "routes": {
    "session_guest": "/v1/session/guest",
    "session_refresh": "/v1/session/refresh",
    "player_sync": "/v1/player/sync",
    "authority_intent": "/v1/game/intent",
    "friends_list": "/v1/social/friends",
    "friend_request": "/v1/social/friend-request",
    "friend_accept": "/v1/social/friend-accept",
    "guild_snapshot": "/v1/guild/snapshot",
    "guild_create": "/v1/guild/create",
    "guild_join": "/v1/guild/join",
    "guild_leave": "/v1/guild/leave",
    "ranking_snapshot": "/v1/rankings/snapshot",
    "ranking_claim": "/v1/rankings/claim",
    "remote_spin": "/v1/game/spin",
    "remote_combat_defeat": "/v1/game/combat/defeat",
    "guild_boss_snapshot": "/v1/guild/boss/snapshot",
    "guild_boss_attack": "/v1/guild/boss/attack",
    "guild_boss_claim": "/v1/guild/boss/claim",
    "pvp_opponents": "/v1/pvp/opponents",
    "pvp_attack": "/v1/pvp/attack",
    "pvp_history": "/v1/pvp/history",
    "pvp_claim": "/v1/pvp/claim",
    "inventory_snapshot": "/v1/inventory/snapshot",
    "entitlements_snapshot": "/v1/entitlements/snapshot",
    "purchase_validate": "/v1/store/validate",
    "loadout_snapshot": "/v1/loadout/snapshot",
    "loadout_publish": "/v1/loadout/publish",
    "pvp_matchmaking": "/v1/pvp/matchmaking",
    "pvp_defense_snapshot": "/v1/pvp/defense-snapshot",
    "pvp_season_snapshot": "/v1/pvp/season",
    "reward_ledger_snapshot": "/v1/rewards/ledger",
    "reward_claim": "/v1/rewards/claim",
    "guild_boss_phase": "/v1/guild/boss/phase",
    "guild_boss_contribution": "/v1/guild/boss/contribution",
    "guild_boss_reward_tiers": "/v1/guild/boss/reward-tiers",
    "pvp_league_snapshot": "/v1/pvp/league",
    "pvp_season_progress": "/v1/pvp/season/progress",
    "pvp_defense_team_get": "/v1/pvp/defense-team",
    "pvp_defense_team_publish": "/v1/pvp/defense-team/publish",
    "guild_governance_snapshot": "/v1/guild/governance",
    "guild_role_update": "/v1/guild/role-update",
    "guild_member_action": "/v1/guild/member-action",
    "guild_tasks_snapshot": "/v1/guild/tasks",
    "guild_task_contribute": "/v1/guild/tasks/contribute",
    "guild_donation": "/v1/guild/donation",
    "activity_feed": "/v1/activity/feed",
    "notifications_snapshot": "/v1/notifications",
    "notification_mark_read": "/v1/notifications/read",
    "pvp_season_settlement": "/v1/pvp/season/settlement",
    "pvp_season_claim": "/v1/pvp/season/claim",
    "guild_search": "/v1/guild/search",
    "guild_applications": "/v1/guild/applications",
    "guild_apply": "/v1/guild/apply",
    "guild_application_action": "/v1/guild/application-action",
    "guild_invites": "/v1/guild/invites",
    "guild_invite_send": "/v1/guild/invite",
    "guild_invite_action": "/v1/guild/invite-action",
    "social_block_list": "/v1/moderation/blocks",
    "social_block": "/v1/moderation/block",
    "social_unblock": "/v1/moderation/unblock",
    "social_report": "/v1/moderation/report",
    "push_register": "/v1/push/register",
    "push_unregister": "/v1/push/unregister",
    "push_preferences": "/v1/push/preferences",
    "season_reset_snapshot": "/v1/pvp/season/reset",
    "season_reset_ack": "/v1/pvp/season/reset/ack",
    "guild_donation_receipt": "/v1/guild/donation/receipt"
  },
  "response_router_contract_version": "response-router-v1",
  "network_resilience_contract_version": "network-resilience-v1",
  "social_contract_version": "social-service-v1",
  "guild_contract_version": "guild-service-v1",
  "ranking_contract_version": "ranking-service-v1",
  "remote_gameplay_contract_version": "remote-gameplay-v1",
  "guild_boss_contract_version": "guild-boss-v1",
  "async_pvp_contract_version": "async-pvp-v1",
  "remote_gameplay_policy": {
    "spin_rng_server_only_in_online_mode": true,
    "spin_cost_and_reward_server_atomic": true,
    "combat_reward_server_only_in_online_mode": true,
    "client_damage_prediction_allowed": true,
    "valuable_result_requires_revision": true,
    "valuable_result_requires_server_time": true
  },
  "async_pvp_policy": {
    "server_selects_opponents": true,
    "server_resolves_result": true,
    "client_submits_loadout_snapshot_reference": true,
    "no_realtime_transport_required": true,
    "matchmaking_ticket_server_owned": true,
    "defense_snapshot_server_owned": true,
    "season_state_server_owned": true,
    "rating_and_league_server_owned": true,
    "league_thresholds_server_owned": true,
    "season_progress_server_owned": true,
    "defense_team_server_snapshot_required": true,
    "promotion_and_demotion_server_owned": true
  },
  "guild_boss_policy": {
    "server_owns_global_hp": true,
    "server_owns_contribution": true,
    "server_owns_reward_eligibility": true,
    "optimistic_concurrency_token_required": true,
    "duplicate_attack_idempotency_required": true,
    "stale_attack_revision_rejected": true,
    "phases_server_owned": true,
    "contribution_tiers_server_owned": true,
    "reward_tiers_server_owned": true,
    "phase_transition_server_owned": true
  },
  "inventory_contract_version": "inventory-entitlements-v1",
  "loadout_contract_version": "loadout-snapshot-v1",
  "guild_boss_concurrency_contract_version": "guild-boss-concurrency-v1",
  "pvp_matchmaking_contract_version": "async-pvp-matchmaking-v2",
  "inventory_policy": {
    "server_owns_items": true,
    "server_owns_entitlements": true,
    "client_catalog_is_display_only": true,
    "store_receipt_requires_server_validation": true,
    "client_purchase_callback_never_grants_entitlement": true
  },
  "loadout_policy": {
    "server_snapshot_id_required_for_async_pvp": true,
    "server_snapshot_id_required_for_guild_boss": true,
    "client_can_build_candidate_snapshot": true,
    "server_publishes_revision": true
  },
  "reward_ledger_contract_version": "reward-ledger-v1",
  "guild_raid_contract_version": "guild-raid-v2",
  "pvp_season_contract_version": "pvp-season-v2",
  "defense_team_contract_version": "defense-team-v1",
  "reward_ledger_policy": {
    "server_owns_claim_state": true,
    "claim_id_is_idempotency_key": true,
    "claim_requires_expected_revision": true,
    "duplicate_claim_returns_same_committed_result": true,
    "client_never_marks_claimed_before_server_confirmation": true
  },
  "guild_governance_contract_version": "guild-governance-v1",
  "guild_tasks_contract_version": "guild-tasks-v1",
  "activity_contract_version": "activity-feed-v1",
  "notification_contract_version": "notification-center-v1",
  "season_settlement_contract_version": "season-settlement-v1",
  "guild_governance_policy": {
    "server_owns_roles_and_permissions": true,
    "client_checks_permission_snapshot_for_ui_only": true,
    "member_kick_promote_demote_server_only": true,
    "guild_donations_server_transactional": true
  },
  "activity_policy": {
    "server_owns_activity_ordering": true,
    "server_owns_notification_read_state": true,
    "client_does_not_fabricate_social_activity": true
  },
  "season_settlement_policy": {
    "server_owns_final_rank_and_reward": true,
    "settlement_id_is_idempotent": true,
    "season_claim_uses_reward_ledger": true
  },
  "guild_discovery_contract_version": "guild-discovery-v1",
  "moderation_contract_version": "social-moderation-v1",
  "push_contract_version": "push-notification-v1",
  "season_reset_contract_version": "season-reset-v1",
  "donation_ledger_contract_version": "guild-donation-ledger-v1",
  "guild_discovery_policy": {
    "search_results_server_owned": true,
    "applications_server_owned": true,
    "invites_server_owned": true,
    "join_eligibility_server_owned": true
  },
  "moderation_policy": {
    "block_list_server_owned": true,
    "reports_are_server_records": true,
    "client_never_assumes_enforcement": true
  },
  "push_policy": {
    "device_registration_server_owned": true,
    "notification_preferences_server_owned": true,
    "push_payload_never_grants_rewards": true
  },
  "season_reset_policy": {
    "reset_job_server_owned": true,
    "final_rating_and_league_server_owned": true,
    "reward_claims_use_reward_ledger": true,
    "client_ack_is_not_reward_claim": true
  },
  "donation_ledger_policy": {
    "donation_request_id_is_idempotency_key": true,
    "donation_receipt_server_owned": true,
    "donation_rewards_use_reward_ledger_claim_id": true
  }
}