  "families": {
    "monster": {
      "fit": "contain",
      "max_screen_width_ratio": 0.72,
      "max_screen_height_ratio": 0.42,
      "anchor": "center",
      "states": [
        "idle",
        "attack",
        "hit",
        "defeated"
      ]
    },
    "primary_button": {
      "min_height": 96,
      "patch_ratio": 0.2,
      "text_min": 22,
      "padding_x": 28,
      "runtime_text": true
    },
    "secondary_button": {
      "min_height": 78,
      "patch_ratio": 0.18,
      "text_min": 20,
      "padding_x": 24,
      "runtime_text": true
    },
    "panel": {
      "patch_ratio": 0.14,
      "padding_x": 24,
      "padding_y": 20,
      "runtime_text": true
    },
    "progress_bar": {
      "min_height": 54,
      "patch_ratio": 0.2,
      "runtime_fill": true
    },
    "resource_pill": {
      "fit": "contain",
      "min_height": 58,
      "text": "runtime"
    },
    "icon": {
      "min_size": 56,
      "keep_aspect": true,
      "runtime_text": false
    },
    "village_building": {
      "fit": "contain",
      "max_width_ratio": 0.28,
      "label": "runtime"
    },
    "primary_navigation": {
      "fit": "icon_and_runtime_label",
      "min_height": 110,
      "icon_max_width": 58,
      "text": "runtime"
    },
    "reward_slot": {
      "min_size": 88,
      "keep_aspect": true,
      "runtime_icon": true,
      "runtime_value": true
    }
  },
  "dedupe": {
    "exact_hash": "keep_one_canonical_mark_others_alias",
    "visual_similar": "review_only",
    "never_auto_delete": true
